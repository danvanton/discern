# The MakeMKV release Discern installs (decision D6).
#
# scripts/update-makemkv-pin.sh writes this file from MakeMKV's signed
# checksum file (makemkv-sha.txt, next to it), after checking the signature
# with the pinned key. Don't edit it by hand: TestPinMatchesSignedFile fails
# if it disagrees with the signed file.
#
# Read by internal/makemkv/install (embedded in the binary), by the Dockerfile
# (which builds makemkv-oss) and by the release workflow.
MAKEMKV_VERSION=2.0.0
MAKEMKV_BIN_SHA256=f1265e74875a186efdfbbbec7459a64e969033515e53cbc4d805f0a374f0a124
MAKEMKV_OSS_SHA256=435316b2d219eb48c880526557addd076b5f5e6de5171424c7651f9cac95b161
